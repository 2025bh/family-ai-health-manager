# 数据库：开发环境默认 SQLite，正式环境可换 PostgreSQL
DATABASE_URL=sqlite:///./data/familycare.db
APP_ENV=development
API_HOST=0.0.0.0
API_PORT=8000
FRONTEND_ORIGIN=http://localhost:5173

# mock（默认）或 openai_compatible
LLM_PROVIDER=mock
LLM_BASE_URL=https://api.openai.com/v1
LLM_API_KEY=
LLM_MODEL=gpt-4.1-mini

# mock（默认）或 feishu
FEISHU_PROVIDER=mock
FEISHU_APP_ID=
FEISHU_APP_SECRET=
FEISHU_BASE_TOKEN=NUXQbSoUoaawZksn4bLcJI5In7g
# 可选：个人知识库通常优先使用 user access token；只放 .env，不要提交 Git
FEISHU_USER_ACCESS_TOKEN=
FEISHU_PARENT_WIKI_TOKEN=ZLGKwWARWiXyLvk5enecv1vYnVf

# mock 模式不会真的拨号或发送通知
PHONE_PROVIDER=mock
UPLOAD_DIR=./data/uploads
SCHEDULER_ENABLED=true
